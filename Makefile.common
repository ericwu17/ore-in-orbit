# Ore in Orbit — build rules shared by every platform.
#
# Not used on its own: Makefile.macos / Makefile.linux / Makefile.windows set
# the platform-specific variables below and then include this file. The
# top-level Makefile picks the right one for the host.
#
# Each platform makefile must set, before including this file:
#   EXE               the executable's file name
#   BUILD_DIR         where objects go (one per platform, so builds never collide)
#   CXX               the compiler
#   LIBS              link flags for the app (not the headless tests)
# and may set:
#   PLATFORM_CXXFLAGS extra compile flags
#   PLATFORM_SOURCES  extra app sources (.cpp, or Objective-C++ .mm)
#
# Layout mirrors imgui/examples/example_sdl2_opengl3/Makefile, with our own
# sources under src/ (one subdirectory per layer: sim/, persistence/, ui/,
# app/) and all object files under $(BUILD_DIR), mirroring that tree
# (keeping the imgui submodule pristine).

IMGUI_DIR = imgui
# ImPlot (charts), a submodule built against imgui.
IMPLOT_DIR = implot
# Vendored single-header libraries: stb_image (app icon, sprites), nlohmann::json
# (save files)
THIRD_PARTY_DIR = third_party

CXXFLAGS = -std=c++20 -g
# Only src/ itself: our includes name their layer ("sim/world.h").
CXXFLAGS += -Isrc
# Vendored headers are treated as system headers so they can't trip the
# warnings-as-errors build of our own sources.
CXXFLAGS += -isystem $(IMGUI_DIR) -isystem $(IMGUI_DIR)/backends -isystem $(IMPLOT_DIR) -isystem $(THIRD_PARTY_DIR)
CXXFLAGS += $(shell sdl2-config --cflags)
CXXFLAGS += $(PLATFORM_CXXFLAGS)
# Saves are JSON (vendored nlohmann::json): never write an enum as a number
# by mistake; src/persistence/save_file.cpp writes each one by name. Set for
# every file, so all of them see the same json.
CXXFLAGS += -DJSON_DISABLE_ENUM_SERIALIZATION=1
CXXFLAGS += -MMD -MP   # header dependency tracking
# Build-time generated headers (logo_png.h, roboto_ttf.h, sprites_png.h: see
# the embed rules below).
GENERATED_DIR = $(BUILD_DIR)/generated
CXXFLAGS += -I$(GENERATED_DIR)

# Comprehensive but non-opinionated warning set for our own code (src/, tests/),
# with warnings treated as errors. Third-party code (imgui) is built with
# neither these flags nor -Werror.
WARNINGS  = -Wall -Wextra -Wpedantic -Werror
WARNINGS += -Wshadow -Wnon-virtual-dtor -Woverloaded-virtual
WARNINGS += -Wcast-align -Wnull-dereference -Wimplicit-fallthrough
WARNINGS += -Wformat=2
WARNINGS += -Wconversion   # implicit narrowing (double->float, int64->int, ...) needs a cast

# One list per layer (src/<layer>/). The simulation and the save files are
# pure logic, no SDL/imgui/OpenGL: the headless tests link against exactly
# those objects. Keep presentation code out of them.
SIM_SOURCES         = $(wildcard src/sim/*.cpp)
PERSISTENCE_SOURCES = $(wildcard src/persistence/*.cpp)
UI_SOURCES          = $(wildcard src/ui/*.cpp)
# main.cpp is shared by all platforms; platform-only files (the macOS .mm)
# come in through PLATFORM_SOURCES.
SHELL_SOURCES       = src/app/main.cpp src/app/app_icon.cpp $(PLATFORM_SOURCES)
HEADLESS_SOURCES    = $(SIM_SOURCES) $(PERSISTENCE_SOURCES)
APP_SOURCES         = $(HEADLESS_SOURCES) $(UI_SOURCES) $(SHELL_SOURCES)
# One headless test binary per tests/test_*.cpp file (see the test rules below).
TEST_SOURCES := $(wildcard tests/*.cpp)
TEST_EXES    := $(patsubst tests/%.cpp,$(BUILD_DIR)/%,$(TEST_SOURCES))

IMGUI_SOURCES  = $(IMGUI_DIR)/imgui.cpp $(IMGUI_DIR)/imgui_demo.cpp $(IMGUI_DIR)/imgui_draw.cpp
IMGUI_SOURCES += $(IMGUI_DIR)/imgui_tables.cpp $(IMGUI_DIR)/imgui_widgets.cpp
IMGUI_SOURCES += $(IMGUI_DIR)/backends/imgui_impl_sdl2.cpp $(IMGUI_DIR)/backends/imgui_impl_opengl3.cpp

IMPLOT_SOURCES = $(IMPLOT_DIR)/implot.cpp $(IMPLOT_DIR)/implot_items.cpp $(IMPLOT_DIR)/implot_demo.cpp

VENDOR_SOURCES = $(IMGUI_SOURCES) $(IMPLOT_SOURCES)

# src/sim/world.cpp -> $(BUILD_DIR)/src/sim/world.o, imgui/imgui.cpp -> $(BUILD_DIR)/imgui/imgui.o, etc.
APP_CPP_OBJS    := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(filter %.cpp,$(APP_SOURCES)))
APP_MM_OBJS     := $(patsubst %.mm,$(BUILD_DIR)/%.o,$(filter %.mm,$(APP_SOURCES)))
TEST_OBJS       := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(TEST_SOURCES))
VENDOR_CPP_OBJS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(VENDOR_SOURCES))
HEADLESS_OBJS   := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(HEADLESS_SOURCES))
# OBJS links into $(EXE); test objects stay out (they contain their own main).
OBJS := $(APP_CPP_OBJS) $(APP_MM_OBJS) $(VENDOR_CPP_OBJS)
DEPS := $(OBJS:.o=.d) $(TEST_OBJS:.o=.d)
# Objects built with the full warning set (everything we wrote, tests included).
OUR_CPP_OBJS := $(APP_CPP_OBJS) $(TEST_OBJS)

all: $(EXE)

$(EXE): $(OBJS)
	$(CXX) -o $@ $^ $(LIBS)

# Our own code: full warning set, warnings as errors.
$(OUR_CPP_OBJS): $(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(WARNINGS) -c -o $@ $<

# Objective-C++ files (platform_macos.mm) need the ObjC++ flags. Guarded:
# a static pattern rule with an empty target list would degrade to a bare
# pattern rule matching every object in the build.
ifneq ($(APP_MM_OBJS),)
$(APP_MM_OBJS): $(BUILD_DIR)/%.o: %.mm
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(WARNINGS) -ObjC++ -fobjc-weak -fobjc-arc -c -o $@ $<
endif

# Vendored code (imgui): no extra warnings, no -Werror.
$(VENDOR_CPP_OBJS): $(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# Headless tests (no window, no SDL): make test builds and runs one binary
# per tests/test_*.cpp, each linked against exactly the simulation objects.
# Tests run from the repo root.
test: $(TEST_EXES)
	@for exe in $(TEST_EXES); do ./$$exe || exit 1; done

$(BUILD_DIR)/test_%: $(BUILD_DIR)/tests/test_%.o $(HEADLESS_OBJS)
	$(CXX) -o $@ $^

# The tests are assert-based: force asserts on for test objects so a stray
# -DNDEBUG in CXXFLAGS can never turn them into silent no-ops.
$(TEST_OBJS): CXXFLAGS += -UNDEBUG

# Embed assets/logo.png as a C array (app icon, see src/app/app_icon.h). Uses od
# + sed rather than xxd so it needs nothing beyond the POSIX tools.
LOGO_HEADER = $(GENERATED_DIR)/logo_png.h
$(LOGO_HEADER): assets/logo.png
	@mkdir -p $(dir $@)
	{ echo '// Generated from $< by the makefile. Do not edit.'; \
	  echo 'static const unsigned char kLogoPng[] = {'; \
	  od -An -v -tx1 $< | sed 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	  echo '};'; } > $@

$(BUILD_DIR)/src/app/app_icon.o: $(LOGO_HEADER)

# Embed the UI font (Roboto Medium, shipped with imgui) the same way, so the
# app finds it however it is launched (see src/ui/ui_theme.h).
FONT_HEADER = $(GENERATED_DIR)/roboto_ttf.h
$(FONT_HEADER): $(IMGUI_DIR)/misc/fonts/Roboto-Medium.ttf
	@mkdir -p $(dir $@)
	{ echo '// Generated from $< by the makefile. Do not edit.'; \
	  echo 'static const unsigned char kRobotoTtf[] = {'; \
	  od -An -v -tx1 $< | sed 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	  echo '};'; } > $@

$(BUILD_DIR)/src/ui/ui_theme.o: $(FONT_HEADER)

# Embed every sprite under assets/sprites/ (see src/ui/sprites.h) the same
# way: one array per PNG, plus kEmbeddedSprites[], the table of them by path
# ("items/IronPlate.png"), ended by a null entry. sprite_list.txt holds the
# list of files and is only rewritten when it changes, so adding or deleting
# a sprite regenerates the header too (the wildcard alone wouldn't).
SPRITES_DIR    = assets/sprites
SPRITE_PNGS   := $(sort $(wildcard $(SPRITES_DIR)/*/*.png))
SPRITE_LIST    = $(GENERATED_DIR)/sprite_list.txt
SPRITES_HEADER = $(GENERATED_DIR)/sprites_png.h
$(SPRITE_LIST): FORCE
	@mkdir -p $(dir $@)
	@echo '$(SPRITE_PNGS)' | cmp -s - $@ || echo '$(SPRITE_PNGS)' > $@

$(SPRITES_HEADER): $(SPRITE_LIST) $(SPRITE_PNGS)
	@mkdir -p $(dir $@)
	@{ echo '// Generated from $(SPRITES_DIR)/ by the makefile. Do not edit.'; \
	  n=0; for f in $(SPRITE_PNGS); do \
	    echo "static const unsigned char kSprite$$n[] = {"; \
	    od -An -v -tx1 "$$f" | sed 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	    echo '};'; n=$$((n + 1)); \
	  done; \
	  echo 'struct EmbeddedSprite { const char* path; const unsigned char* data; std::size_t size; };'; \
	  echo 'static const EmbeddedSprite kEmbeddedSprites[] = {'; \
	  n=0; for f in $(SPRITE_PNGS); do \
	    echo "    {\"$${f#$(SPRITES_DIR)/}\", kSprite$$n, sizeof(kSprite$$n)},"; n=$$((n + 1)); \
	  done; \
	  echo '    {nullptr, nullptr, 0},'; \
	  echo '};'; } > $@
	@echo "Embedded $(words $(SPRITE_PNGS)) sprites into $@"

$(BUILD_DIR)/src/ui/sprites.o: $(SPRITES_HEADER)

clean:
	rm -rf $(BUILD_DIR) $(EXE)

-include $(DEPS)

.PHONY: all clean test FORCE
