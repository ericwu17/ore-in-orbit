# Ore in Orbit — SDL2 + OpenGL3 + Dear ImGui (macOS)
#
# Included by the top-level Makefile on macOS; bare `make` just works.
# Requires SDL2:  brew install sdl2
# Build & run:    make && ./ore-in-orbit
#
# Only the macOS-specific settings live here (platform_macos.mm, the OpenGL
# framework, GL deprecation silencing); every rule is in Makefile.common.

EXE       = ore-in-orbit
BUILD_DIR = build

# Hard-set, not `?=`: make predefines CXX=c++, so `?=` would never apply
# (override on the command line with `make CXX=g++ ...` if preferred).
CXX = clang++

# OpenGL is deprecated on macOS (but fully functional) — silence the warnings
# so our -Werror build of main.cpp stays clean.
PLATFORM_CXXFLAGS = -DGL_SILENCE_DEPRECATION

# platform_macos.mm holds the macOS-only startup tweaks (see src/app/platform_macos.h).
PLATFORM_SOURCES = src/app/platform_macos.mm

LIBS  = -framework OpenGL
LIBS += $(shell sdl2-config --libs)

include Makefile.common

# `make app` packages the game as "build/Ore in Orbit.app" (bundled SDL, icon,
# ad-hoc signature): see tools/macos/make_app.sh. The bundle needs the same
# macOS as the SDL it was linked against, which for Homebrew's SDL is this
# machine's version. For a bundle that runs on older macOS, build SDL with
# tools/macos/build_sdl.sh, put its bin/ first on PATH and build with
# MACOSX_DEPLOYMENT_TARGET set, as .github/workflows/macos-app.yml does.
app: $(EXE)
	tools/macos/make_app.sh $(EXE) "$(BUILD_DIR)/Ore in Orbit.app"

.PHONY: app
